{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@game/*": ["./src/game/*"],
      "@core/*": ["./src/core/*"],
      "@ui/*": ["./src/ui/*"],
      "@main/*": ["./src/main/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
