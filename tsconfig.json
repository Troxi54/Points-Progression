{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",

    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "moduleResolution": "bundler",
    "paths": {
      "@game/*": ["./src/game/*"],
      "@core/*": ["./src/core/*"],
      "@ui/*": ["./src/ui/*"],
      "@main/*": ["./src/main/*"],
      "@/*": ["./src/*"]
    },
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,

    "skipLibCheck": true
  },
  "include": ["src"]
}
