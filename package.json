{
  "name": "points-progression",
  "type": "module",
  "version": "1.2.7",
  "private": true,
  "homepage": "https://troxi54.github.io/Points-Progression/",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "format": "npx prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "build": "npm run typecheck && vite build",
    "build:analyze": "npm run typecheck && vite build --mode analyze",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bench": "vitest bench",
    "preview": "vite preview",
    "deploy": "git switch main && npm run build && gh-pages -d dist && git push --force-with-lease origin HEAD:refs/heads/last-deployed",
    "test": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@zod/mini": "4.6.7",
    "break_eternity.js": "2.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "immer": "11.2.10",
    "lz-string": "1.5.0",
    "pluralize": "8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "use-sync-external-store": "1.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@eslint-react/eslint-plugin": "5.30.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-refresh": "0.5.7",
    "gh-pages": "6.3.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rollup-plugin-visualizer": "7.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
