{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": true,
  "automergeType": "pr",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Automatically merge patch and minor updates after CI passes",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Keep major updates for manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
